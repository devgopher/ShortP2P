<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ShortP2P.Auth</RootNamespace>
    <AssemblyName>ShortP2P.Auth</AssemblyName>
    <Description>.NET Framework 4.8 build of ShortP2P.Auth (shared sources).</Description>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ShortP2P.Auth\**\*.cs" Exclude="..\ShortP2P.Auth\obj\**\*.cs;..\ShortP2P.Auth\bin\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="ShortP2P.Crypto.Fx48.csproj" />
  </ItemGroup>
</Project>

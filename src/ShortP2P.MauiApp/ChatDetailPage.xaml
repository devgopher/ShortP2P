<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShortP2P.MauiApp.ChatDetailPage"
             Title="Chat">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Image" Order="Primary" Priority="2" Clicked="OnAttachImageClicked" />
        <ToolbarItem Text="Document" Order="Primary" Priority="1" Clicked="OnAttachDocumentClicked" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="8" RowSpacing="8">
        <VerticalStackLayout Grid.Row="0" Spacing="6" Padding="0,0,0,4">
            <Label x:Name="PeerIdLabel" FontSize="12" TextColor="Gray" />
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Ellipse x:Name="PeerPresenceDot" WidthRequest="10" HeightRequest="10" VerticalOptions="Center"
                         Fill="#CD5C5C" />
                <Label x:Name="PeerStatusLabel" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <CollectionView x:Name="MessagesCollection" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMessageRowTapped" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{Binding CaptionLine}" TextColor="{Binding MessageColor}" FontAttributes="Bold"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding TextBody}" TextColor="{Binding MessageColor}" LineBreakMode="WordWrap"
                                   IsVisible="{Binding ShowTextBody}" />
                            <Label FormattedText="{Binding FileBodyFormatted}" LineBreakMode="WordWrap"
                                   IsVisible="{Binding IsFile}" />
                            <Image Source="{Binding ImagePreview}" IsVisible="{Binding IsImage}" MaximumHeightRequest="240"
                                   Aspect="AspectFit" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding DeliveryGlyph}" TextColor="{Binding DeliveryGlyphColor}"
                               FontSize="15" VerticalOptions="Start" IsVisible="{Binding ShowDelivery}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Border Grid.Row="2" Stroke="#CCCCCC" StrokeThickness="1" Padding="8,6" StrokeShape="RoundRectangle 4">
            <VerticalStackLayout Spacing="6">
                <Label Text="TECH" FontSize="11" TextColor="Gray" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Send handshake" Clicked="OnTechHandshakeClicked" />
                    <Button Text="Send ping" Clicked="OnTechPingClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="MessageEntry" Grid.Column="0" Placeholder="Message" MaxLength="32768" />
            <Button Grid.Column="1" Text="Send" Clicked="OnSendClicked" />
        </Grid>
    </Grid>
</ContentPage>

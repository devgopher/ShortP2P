<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShortP2P.MauiApp.ChatDetailPage"
             Title="Chat">
    <Grid RowDefinitions="*,Auto" Padding="8" RowSpacing="8">
        <CollectionView x:Name="MessagesCollection" Grid.Row="0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="{Binding DirectionLabel}" FontSize="12" TextColor="Gray" VerticalOptions="Start" Margin="0,2,8,0" />
                        <Label Grid.Column="1" Text="{Binding Text}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="MessageEntry" Grid.Column="0" Placeholder="Message" />
            <Button Grid.Column="1" Text="Send" Clicked="OnSendClicked" />
        </Grid>
    </Grid>
</ContentPage>

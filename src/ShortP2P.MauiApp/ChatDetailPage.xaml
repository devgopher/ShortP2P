<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShortP2P.MauiApp.ChatDetailPage"
             Title="Chat">
    <Grid RowDefinitions="Auto,*,Auto" Padding="8" RowSpacing="8">
        <VerticalStackLayout Grid.Row="0" Spacing="6" Padding="0,0,0,4">
            <Label x:Name="PeerIdLabel" FontSize="12" TextColor="Gray" />
            <Label x:Name="PeerStatusLabel" FontSize="12" TextColor="Gray" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6" RowDefinitions="Auto">
                <Label Grid.Column="0" Text="IP" FontSize="12" VerticalOptions="Center" TextColor="Gray" />
                <Entry x:Name="PeerHostEntry" Grid.Column="1" Placeholder="192.168.1.1" />
                <Label Grid.Column="2" Text="Порт" FontSize="12" VerticalOptions="Center" TextColor="Gray" />
                <Entry x:Name="PeerPortEntry" Grid.Column="3" WidthRequest="88" Keyboard="Numeric" Placeholder="17201" />
                <Button x:Name="ApplyPeerEndpointButton" Grid.Column="4" Text="Применить" Clicked="OnApplyPeerEndpointClicked" />
            </Grid>
        </VerticalStackLayout>
        <CollectionView x:Name="MessagesCollection" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="{Binding DirectionLabel}" FontSize="12" TextColor="Gray" VerticalOptions="Start" Margin="0,2,8,0" />
                        <Label Grid.Column="1" Text="{Binding Text}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="MessageEntry" Grid.Column="0" Placeholder="Message" />
            <Button Grid.Column="1" Text="Send" Clicked="OnSendClicked" />
        </Grid>
    </Grid>
</ContentPage>

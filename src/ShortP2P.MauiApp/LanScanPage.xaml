<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShortP2P.MauiApp.LanScanPage"
             Title="LAN scan">
    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="10">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label
                Text="LAN (UDP 17501 / discovery 17890) and messenger servers (GetClients). Tap Scan, then double-tap a peer to start a chat."
                FontSize="12" TextColor="Gray" />
            <Button x:Name="ScanButton" Text="Scan" Clicked="OnScanClicked" />
            <Label x:Name="StatusLabel" FontSize="12" TextColor="Gray" Text="" />
        </VerticalStackLayout>
        <CollectionView x:Name="PeerCollection" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8" ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnPeerDoubleTapped" />
                        </Grid.GestureRecognizers>
                        <Ellipse Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" WidthRequest="10" HeightRequest="10"
                                 VerticalOptions="Center" Fill="#CD5C5C">
                            <Ellipse.Triggers>
                                <DataTrigger TargetType="Ellipse" Binding="{Binding IsPeerOnline}" Value="True">
                                    <Setter Property="Fill" Value="#228B22" />
                                </DataTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Nickname}" FontSize="16" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding NetworkIdShort}" FontSize="12"
                               TextColor="Gray" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding DetailLine}" FontSize="11" TextColor="Gray" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShortP2P.MauiApp.AddChatPage"
             Title="Add P2P chat">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel" Clicked="OnCancelClicked" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Peer nickname" />
            <Entry x:Name="PeerNickEntry" Placeholder="Alice" />
            <Label Text="Peer network id (short)" />
            <Entry x:Name="PeerIdEntry" Placeholder="from peer's profile" />
            <Label Text="Peer RSA public key (JSON)" />
            <Editor x:Name="PeerPubKeyEditor" Placeholder="Peer public key JSON (M, E)" AutoSize="TextChanges" MinimumHeightRequest="120" />
            <Label Text="Peer host / IP" />
            <Entry x:Name="PeerHostEntry" Text="127.0.0.1" />
            <Label Text="Peer UDP data port" />
            <Entry x:Name="PeerPortEntry" Text="17201" Keyboard="Numeric" />
            <Button Text="Scan QR (camera)…" Clicked="OnScanQrCameraClicked" />
            <Button Text="Fill from QR image…" Clicked="OnScanQrClicked" />
            <Button Text="Save" Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

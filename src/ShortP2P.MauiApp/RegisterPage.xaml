<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShortP2P.MauiApp.RegisterPage"
             Title="Register">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Create account" FontSize="24" SemanticProperties.HeadingLevel="Level1" />
            <Label
                Text="Choose a nickname and password. A network id (compressed UUID) is generated and saved locally." />
            <Entry x:Name="NicknameEntry" Placeholder="Nickname" />
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
            <Button Text="Register" Clicked="OnRegisterClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
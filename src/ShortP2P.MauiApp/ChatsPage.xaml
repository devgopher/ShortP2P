<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShortP2P.MauiApp.ChatsPage"
             Title="Chats">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Order="Primary" Priority="0" Clicked="OnAddChatClicked" />
        <ToolbarItem Text="My QR" Order="Primary" Priority="1" Clicked="OnMyQrClicked" />
        <ToolbarItem Text="My addresses" Order="Secondary" Clicked="OnMyAddressesClicked" />
        <ToolbarItem Text="Copy keys" Order="Secondary" Clicked="OnCopyKeysClicked" />
        <ToolbarItem Text="P2P routing" Order="Secondary" Clicked="OnRoutingClicked" />
        <ToolbarItem Text="LAN scan" Order="Secondary" Clicked="OnLanScanClicked" />
        <ToolbarItem Text="Logs" Order="Secondary" Clicked="OnLogsClicked" />
        <ToolbarItem Text="Logout" Order="Secondary" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="8">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label x:Name="ProfileLabel" FontSize="12" TextColor="Gray" />
            <Label Text="P2P chats (UDP). Swipe left on a row and tap Delete to remove the chat on this device only."
                   FontSize="12" TextColor="Gray" />
        </VerticalStackLayout>
        <CollectionView x:Name="ChatsCollection" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnChatSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Delete" BackgroundColor="DarkRed" Invoked="OnChatSwipeDelete" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid Padding="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Ellipse Grid.Column="0" WidthRequest="10" HeightRequest="10" VerticalOptions="Center"
                                     HorizontalOptions="Center" Fill="#CD5C5C">
                                <Ellipse.Triggers>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsPeerOnline}" Value="True">
                                        <Setter Property="Fill" Value="#228B22" />
                                    </DataTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding PeerNickname}" FontSize="18" />
                                <Label Text="{Binding PeerNetworkIdShort}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" VerticalOptions="Center" FontSize="20" TextColor="Gray" />
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
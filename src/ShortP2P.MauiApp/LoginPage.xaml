<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShortP2P.MauiApp.LoginPage"
             Title="Login">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="ShortP2P" FontSize="28" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Sign in with your nickname and password (key stored on this device)." />
            <Entry x:Name="NicknameEntry" Placeholder="Nickname" />
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
            <Button Text="Login" Clicked="OnLoginClicked" />
            <Button Text="Create account" Clicked="OnRegisterNavigateClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

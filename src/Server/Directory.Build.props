<Project>
  <!-- Server stack: modern .NET 8 only (no classic .NET Framework). -->
  <PropertyGroup>
    <NetCoreTargetFramework>net8.0</NetCoreTargetFramework>
    <TargetFramework>net8.0</TargetFramework>
    <MicrosoftExtensionsVersion>8.0.0</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsDiAbstractionsVersion>8.0.2</MicrosoftExtensionsDiAbstractionsVersion>
    <MicrosoftExtensionsHostingVersion>8.0.1</MicrosoftExtensionsHostingVersion>
    <MicrosoftAspNetCoreVersion>8.0.11</MicrosoftAspNetCoreVersion>
    <MicrosoftEntityFrameworkCoreVersion>8.0.11</MicrosoftEntityFrameworkCoreVersion>
    <NpgsqlEntityFrameworkCoreVersion>8.0.11</NpgsqlEntityFrameworkCoreVersion>
  </PropertyGroup>
</Project>

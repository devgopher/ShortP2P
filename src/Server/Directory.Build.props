<Project>
  <!-- Server stack: .NET 10 only (no classic .NET Framework). Do not set TargetFramework here — it breaks SDK evaluation (empty TFM). -->
  <PropertyGroup>
    <NetCoreTargetFramework>net10.0</NetCoreTargetFramework>
    <MicrosoftExtensionsVersion>10.0.0</MicrosoftExtensionsVersion>
    <MicrosoftExtensionsDiAbstractionsVersion>10.0.0</MicrosoftExtensionsDiAbstractionsVersion>
    <MicrosoftExtensionsHostingVersion>10.0.0</MicrosoftExtensionsHostingVersion>
    <MicrosoftAspNetCoreVersion>10.0.0</MicrosoftAspNetCoreVersion>
    <MicrosoftEntityFrameworkCoreVersion>10.0.0</MicrosoftEntityFrameworkCoreVersion>
    <NpgsqlEntityFrameworkCoreVersion>10.0.0</NpgsqlEntityFrameworkCoreVersion>
  </PropertyGroup>
</Project>

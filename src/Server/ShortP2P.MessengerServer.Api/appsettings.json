{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InMemoryCacheOptions": {
    "MaxMemoryMegabytes": 512
  },
  "MessengerCache": {
    "CacheEnabled": true,
    "RepositoryEnabled": true,
    "TimeToLive": "00:01:00",
    "PollInterval": "00:00:10"
  },
  "MessengerInbox": {
    "MaxPollTimeoutSeconds": 30,
    "MessageRetention": "30.00:00:00"
  },
  "Persistence": {
    "Enabled": true,
    "ConnectionString": "Host=localhost;Port=5432;Database=shortp2p_messenger;Username=postgres;Password=12345678",
    "ApplyMigrationsOnStartup": true
  },
  "Auth": {
    "Issuer": "ShortP2P.MessengerServer",
    "Audience": "ShortP2P.Clients",
    "SigningKey": "ShortP2P-Dev-Signing-Key-Change-Me-32+",
    "TokenLifetime": "08:00:00",
    "EntityFramework": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=messenger-auth.db",
      "ApplyMigrationsOnStartup": true
    },
    "LiteDb": {
      "ConnectionString": "Filename=messenger-auth.litedb;Connection=shared"
    }
  },
  "HostPowers": {
    "LiteDb": {
      "ConnectionString": "Filename=messenger-host-powers.litedb;Connection=shared"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:51111"
      },
      "Http": {
        "Url": "http://0.0.0.0:51112"
      }
    }
  }
}

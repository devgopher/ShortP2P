{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InMemoryCacheOptions": {
    "MaxMemoryMegabytes": 512
  },
  "MessengerCache": {
    "CacheEnabled": true,
    "RepositoryEnabled": true,
    "TimeToLive": "00:01:00",
    "PollInterval": "00:00:10"
  },
  "Persistence": {
    "Enabled": true,
    "ConnectionString": "Host=localhost;Port=5432;Database=shortp2p_messenger;Username=postgres;Password=postgres",
    "ApplyMigrationsOnStartup": true
  },
  "Auth": {
    "Issuer": "ShortP2P.MessengerServer",
    "Audience": "ShortP2P.Clients",
    "SigningKey": "ShortP2P-Dev-Signing-Key-Change-Me-32+",
    "TokenLifetime": "08:00:00",
    "EntityFramework": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=messenger-auth.db",
      "ApplyMigrationsOnStartup": true
    },
    "LiteDb": {
      "ConnectionString": "Filename=messenger-auth.litedb;Connection=shared"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:7196"
      },
      "Http": {
        "Url": "http://localhost:5299"
      }
    }
  }
}

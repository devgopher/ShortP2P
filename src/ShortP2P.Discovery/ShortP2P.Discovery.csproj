        <Compile Include="..\ShortP2P.Client\Routing\LocalEndpointHelper.cs" Link="Routing\LocalEndpointHelper.cs" />
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>$(NetCoreTargetFramework)</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

</Project>
